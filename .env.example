# Postgres connection (Neon when deployed)
DATABASE_URL=postgres://localhost:5432/your_database

# The one owner. Create the hash with: npm run hash-password -- "your password"
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=scrypt:<salt>:<hash>

# Deployed stores only: Vercel Blob token (a deployed build refuses to start without it)
BLOB_READ_WRITE_TOKEN=
